<?xml version="1.0" encoding="utf-8"?>
<!-- Poly Studio, MSIX manifest template. package-msix.ps1 fills the @...@ values.
     Identity Name, Publisher and PublisherDisplayName must match Partner Center exactly
     (Product management > Product identity). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCH@" />
  <Properties>
    <DisplayName>Poly Studio</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="PolyStudio" Executable="PolyStudio.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Poly Studio"
                          Description="Parametric 3D CAD: sketch, constrain and build solids on an editable feature timeline."
                          BackgroundColor="#FFFFFF"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="polystudiodesign">
            <uap:DisplayName>Poly Studio design</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.sc</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
